
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Application Rejected</title>
</head>

<body style="margin:0;padding:30px;background:#f4f6f9;font-family:Arial,sans-serif;">

  <div style="max-width:600px;margin:auto;background:#ffffff;border-radius:10px;overflow:hidden;">

    <!-- Header -->
    <div style="background:#dc2626;padding:30px;text-align:center;color:#ffffff;">
      <h1 style="margin:0;">Application Rejected</h1>
      <p style="margin-top:10px;">Staff Registration Update</p>
    </div>

    <!-- Body -->
    <div style="padding:30px;color:#333;">

      <h2>Hello <%= fullName %>,</h2>

      <p>
        Thank you for your interest in joining
        <strong><%= companyName %></strong>.
      </p>

      <p>
        We regret to inform you that your staff registration
        application has been reviewed and rejected by our administration team.
      </p>

      <!-- Rejection Information -->
      <div style="background:#fef2f2;padding:20px;border-radius:8px;border-left:4px solid #dc2626;margin:25px 0;">

        <h3 style="margin-top:0;color:#dc2626;">Rejection Details</h3>

        <p><strong>Name:</strong> <%= fullName %></p>

        <p><strong>Email:</strong> <%= email %></p>

        <p><strong>Role:</strong> <%= role %></p>

        <p>
          <strong>Reason:</strong>
          <%= rejectionReason || "Your application did not meet our current registration requirements." %>
        </p>

      </div>

      <p>
        We appreciate your time and understanding.
        If you have any questions regarding this decision,
        please contact our administration team.
      </p>

      <p style="margin-top:30px;">
        Best regards,<br>
        <strong><%= companyName %> Administration Team</strong>
      </p>

    </div>

    <!-- Footer -->
    <div style="background:#f3f4f6;padding:18px;text-align:center;color:#777;font-size:12px;">
      © <%= new Date().getFullYear() %> <%= companyName %>. All rights reserved.
    </div>

  </div>

</body>
</html>
