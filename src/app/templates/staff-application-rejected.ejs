
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Application Update</title>
</head>

<body style="margin:0;padding:30px;background:#f4f6f9;font-family:Arial,sans-serif;">

  <div style="max-width:600px;margin:auto;background:#ffffff;border-radius:10px;overflow:hidden;">

    <!-- Header -->
    <div style="background:#dc2626;padding:30px;text-align:center;color:white;">
      <h1 style="margin:0;">Application Update</h1>
      <p style="margin-bottom:0;">Staff Account Registration</p>
    </div>

    <!-- Content -->
    <div style="padding:30px;color:#333;">

      <h2>Hello <%= fullName %>,</h2>

      <p>
        Thank you for your interest in joining
        <strong><%= companyName %></strong>.
      </p>

      <p>
        After reviewing your staff registration,
        we regret to inform you that your application
        has not been approved at this time.
      </p>

      <!-- Rejection Reason -->
      <div style="background:#fef2f2;border-left:4px solid #dc2626;
                  padding:18px;margin:25px 0;border-radius:5px;">

        <h3 style="margin-top:0;color:#dc2626;">
          Rejection Reason
        </h3>

        <p style="margin-bottom:0;line-height:1.6;">
          <%= rejectionReason || "No specific reason was provided by the administration." %>
        </p>

      </div>

      <p>
        We appreciate your time and understanding.
        If you believe this decision was made in error
        or need further clarification, please contact
        our administration team.
      </p>

      <p>
        Best regards,<br>
        <strong><%= companyName %> Administration Team</strong>
      </p>

    </div>

    <!-- Footer -->
    <div style="background:#f3f4f6;padding:15px;text-align:center;
                color:#777;font-size:12px;">

      © <%= new Date().getFullYear() %> <%= companyName %>.
      All rights reserved.

    </div>

  </div>

</body>
</html>
