model User {
  id              String       @id @default(uuid()) @db.Uuid
  fullName        String
  email           String       @unique
  phone           String?      @unique
  passwor         String?
  googleId        String?
  authProvider    AuthProvider @default(EMAIL)
  status          Status       @default(ACTIVE)
  role            UserRole     @default(CITIZEN)
  isActive        Boolean      @default(true)
  isemailVerified Boolean @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships         DepartmentMembership[]
  submittedComplaints Complaint[]              @relation("ComplaintCreator")
  assignmentsReceived ComplaintAssignment[]    @relation("AssignmentAssignee")
  assignmentsMade     ComplaintAssignment[]    @relation("AssignmentMaker")
  statusChanges       ComplaintStatusHistory[] @relation("StatusChangedBy")
  uploadedAttachments Attachment[]             @relation("AttachmentUploader")
  technicianUpdates   TechnicianUpdate[]
  notifications       Notification[]
  feedbackGiven       Feedback[]               @relation("FeedbackAuthor")
  auditLogs           AuditLog[]               @relation("AuditActor")

  @@index([role, isActive])
  @@index([createdAt])
}
