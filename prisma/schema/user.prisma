model User {
  id              String       @id @default(uuid()) @db.Uuid
  fullName        String
  email           String       @unique
  phone           String?      @unique
  password         String?
  googleId        String?
  imageurl        String?
  imageId         String?
  authProvider    AuthProvider @default(EMAIL)
  status          Status       @default(PANDING)
  role            UserRole     @default(CITIZEN)
  isActive        Boolean      @default(true)
  isemailVerified Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  staff               DepartmentMembership[]
  technician          Technician[]
  submittedComplaints Complaint[]            @relation("ComplaintCreator")
  uploadedAttachments Attachment[]           @relation("AttachmentUploader")
  notifications       Notification[]
  feedbackGiven       Feedback[]             @relation("FeedbackAuthor")
  auditLogs           AuditLog[]             @relation("AuditActor")

  @@index([role, isActive])
  @@index([createdAt])
  @@map("users")
}
