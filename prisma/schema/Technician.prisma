model Technician {
  id          String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  profileId String?
  experience Int?
  workexperienceName String[] @default([])
  createdAt   DateTime @default(now())

  userid    User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}