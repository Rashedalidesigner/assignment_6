

model Complaint {
  id                   String            @id @default(uuid()) @db.Uuid
  title                String
  description          String
  priority             ComplaintPriority @default(NORMAL)
  citizenId            String            @db.Uuid
  categoryId           String            @db.Uuid
  locationId           String            @db.Uuid
  departmentId         String?           @db.Uuid
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  citizen      User             @relation("ComplaintCreator", fields: [citizenId], references: [id], onDelete: Restrict)
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location     ServiceLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attachments  Attachment[]
  feedback     Feedback?
  notifications Notification[]
  auditLogs    AuditLog[]

  @@index([citizenId, createdAt])
  @@index([ priority, createdAt])
  @@index([departmentId, priority])
  @@index([categoryId, createdAt])
  @@index([locationId])
  @@map("complaints")
}
