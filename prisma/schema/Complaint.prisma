

model Complaint {
  id                   String            @id @default(uuid()) @db.Uuid
  ticketNumber         String            @unique @default(uuid())
  title                String
  description          String
  status               ComplaintStatus   @default(SUBMITTED)
  priority             ComplaintPriority @default(NORMAL)
  citizenId            String            @db.Uuid
  categoryId           String            @db.Uuid
  locationId           String            @db.Uuid
  departmentId         String?           @db.Uuid
  slaDueAt             DateTime?
  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  isSlaBreached        Boolean           @default(false)
  reopenedCount        Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  citizen      User             @relation("ComplaintCreator", fields: [citizenId], references: [id], onDelete: Restrict)
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location     ServiceLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments  ComplaintAssignment[]
  statusHistory ComplaintStatusHistory[]
  attachments  Attachment[]
  technicianUpdates TechnicianUpdate[]
  feedback     Feedback?
  notifications Notification[]
  auditLogs    AuditLog[]

  @@index([citizenId, createdAt])
  @@index([status, priority, createdAt])
  @@index([departmentId, status, priority])
  @@index([categoryId, createdAt])
  @@index([locationId])
  @@index([slaDueAt, isSlaBreached])
}
